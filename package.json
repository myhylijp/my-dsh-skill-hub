{
  "name": "my-dsh-skill-hub",
  "version": "0.3.1",
  "license": "MIT",
  "description": "Skills panel: one shared external skill pool plus per-role authorization of pool skills and of each role's system built-in skills",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/myhylijp/my-dsh-skill-hub.git"
  },
  "type": "module",
  "exports": {
    ".": "./host.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "host.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "vendor",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  }
}
